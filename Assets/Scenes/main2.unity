    - target: {fileID: 6117247907801095063, guid: ba1b853eb5f1d774481e543a1ae57530, type: 3}
      propertyPath: m_Text
      value: "\u821E\u53F0\uFF1A\u73FE\u4EE3\u65E5\u672C\u306E\u4E00\u822C\u7684\u306A\u9AD8\u6821\n\u6388\u696D\u3084\u4F11\u307F\u6642\u9593\u3001\u653E\u8AB2\u5F8C\u306A\u3069\u3001\u65E5\u5E38\u7684\u306A\u5B66\u6821\u751F\u6D3B\u3092\u9001\u3063\u3066\u3044\u308B\u3002\n\u4F55\u6C17\u306A\u3044\u4F1A\u8A71\u3084\u5C0F\u3055\u306A\u51FA\u6765\u4E8B\u306E\u4E2D\u3067\u3001\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u306E\u6027\u683C\u3084\u95A2\u4FC2\u6027\u304C\u8868\u308C\u308B\u3088\u3046\u306A\u3082\u306E\u3092\u60F3\u5B9A\u3002"
